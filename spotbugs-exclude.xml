<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <Match>
        <!-- Benchmarks need not be bugfree -->
        <Package name="io.undertow.benchmarks.generated"/>
    </Match>

    <Match>
        <!-- Lomboks auto-generated hashCode -->
        <Method name="hashCode" />
        <Bug pattern="USBR_UNNECESSARY_STORE_BEFORE_RETURN"/>
    </Match>

    <Match>
        <!-- A TimeZone-field is effectively immutable (apart from its ID, which we do not process here) -->
        <Field type="java.util.TimeZone"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
